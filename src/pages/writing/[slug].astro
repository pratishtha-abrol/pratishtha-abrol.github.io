---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { site } from '../../data/site';
import { formatDate } from '../../data/posts';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const description = entry.data.summary ?? `${entry.data.title} — writing by Pratishtha Abrol.`;
---

<BaseLayout title={`${entry.data.title} — Pratishtha Abrol`} description={description} accent="#F58FA3" typewriter>
  <Nav
    suffix="/writing"
    links={[
      { label: 'All writing', href: '/writing/' },
      { label: 'Infra', href: '/infra/' },
      { label: 'Backend', href: '/backend/' },
      { label: 'AI infra', href: '/ai/' },
      { label: 'Research', href: '/research/' },
    ]}
  />
  <main>
    <article class="post">
      <a href="/writing/" class="back">← All writing</a>
      <header>
        <p class="kicker">
          <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
          <span aria-hidden="true"> · </span>{minutes} min read
        </p>
        <h1>{entry.data.title}</h1>
        <p class="byline">by <span>Pratishtha Abrol</span></p>
      </header>
      <div class="prose"><Content /></div>
    </article>

    <ContactCTA
      top={32}
      heading="Want to talk about something here?"
      lead="Freelance projects, long-term contracts, or full-time remote roles."
      headingMax={720}
      links={[
        { label: 'LinkedIn ↗', href: site.linkedin },
        { label: 'GitHub ↗', href: site.github },
        { label: 'All writing →', href: '/writing/' },
      ]}
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .post {
    max-width: calc(62ch + 2 * var(--gutter));
    margin: 0 auto;
    padding: 72px var(--gutter) 24px;
  }
  .back {
    display: inline-block;
    padding: 10px 0;
    font-size: 15px;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  header {
    margin: 32px 0 56px;
    padding: 36px 0 32px;
    border-top: 4px double var(--border-strong);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }
  .kicker {
    color: var(--accent);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  h1 {
    margin-top: 20px;
    font-size: clamp(2rem, 4.6vw, 2.9rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .byline {
    margin-top: 22px;
    color: var(--text-subtle);
    font-size: 15px;
    font-style: italic;
  }
  .byline span {
    color: var(--text-muted);
    font-style: normal;
  }
</style>

<style is:global>
  .prose {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-body);
  }
  .prose > * + * {
    margin-top: 1.4em;
  }
  /* Book-style paragraphs: first-line indent instead of blank space. */
  .prose > p + p {
    margin-top: 0;
    text-indent: 2ch;
  }
  /* Drop cap on the opening paragraph. */
  .prose > p:first-child::first-letter {
    float: left;
    margin: 0.08em 0.12em 0 0;
    font-size: 4.2em;
    line-height: 0.82;
    font-weight: 700;
    color: var(--accent);
  }
  /* Magazine end mark after the last paragraph. */
  .prose > p:last-child::after {
    content: ' ■';
    color: var(--accent);
    font-size: 0.7em;
  }
  .prose h2,
  .prose h3 {
    margin-top: 2.2em;
    text-indent: 0;
    color: var(--text);
    font-weight: 700;
    line-height: 1.3;
  }
  .prose h2 {
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .prose h2 + p {
    margin-top: 0.9em;
    text-indent: 0;
  }
  .prose h3 {
    font-size: 1.1rem;
  }
  .prose a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  /* Pull-quote: centred, set between two accent rules. */
  .prose blockquote {
    margin-inline: 0;
    padding: 1.1em 0.5em;
    border-top: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    text-align: center;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--text);
    font-style: italic;
  }
  .prose blockquote p {
    text-indent: 0;
  }
  .prose code {
    font-size: 0.92em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .prose pre {
    background-color: var(--surface) !important; /* override the code highlighter's theme */
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: 18px 20px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.6;
  }
  .prose pre code {
    background: none;
    border: 0;
    padding: 0;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }
  .prose li + li {
    margin-top: 0.4em;
  }
  .prose hr {
    border: 0;
    margin: 2.4em 0;
    text-align: center;
    color: var(--text-subtle);
  }
  .prose hr::after {
    content: '*   *   *';
    letter-spacing: 0.2em;
  }
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: var(--r-card);
  }
</style>
