---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { mlPipelines } from '../data/projects';

const resume = site.resumes.ai;
---

<BaseLayout
  title="Pratishtha Abrol — AI Infrastructure"
  description="AI infrastructure: serving, scaling and observing models in production. Kubernetes and SRE experience, open-source ML pipelines and a research background."
  accent="#C4A7FF"
  ogImage="/og/ai.png"
>
  <Nav
    suffix="/ai"
    links={[
      { label: 'Research', href: '/research/' },
      { label: 'Infra', href: '/infra/' },
      { label: 'Backend', href: '/backend/' },
    ]}
  />
  <main>
    <Hero eyebrow="AI INFRASTRUCTURE" h1Max={920} leadMax={660}>
      The unglamorous part of AI: <span class="accent">serving it reliably.</span>
      <Fragment slot="lead">
        Models are only useful when they're fast, observable and affordable in production. I bring Kubernetes and SRE
        experience to model serving, plus open-source ML pipeline work and a research background.
      </Fragment>
      <Fragment slot="actions">
        {resume && <Button href={resume} track="resume-ai">Download résumé</Button>}
      </Fragment>
    </Hero>

    <Section top={72} gap={32}>
      <SectionHeader eyebrow="01 / ML PIPELINES" title="Open-source ML infrastructure." />
      <div class="cards">
        {mlPipelines.map((p) => <ProjectCard project={p} />)}
      </div>
    </Section>

    <Section id="research" top={72} flow="block">
      <div class="research">
        <div class="research-head">
          <Eyebrow>02 / RESEARCH</Eyebrow>
          <h2>Comfortable with formal depth.</h2>
        </div>
        <div class="research-body">
          <p>
            MS by Research at IIIT Hyderabad's Centre for Quantum Science and Technology. I can read papers, reason about
            proofs, and turn ideas into working systems.
          </p>
          <a href={site.paper.doi} class="paper">
            <span class="paper-title">Maximal Secret Reconstruction, Teleportation and Bell's Inequality ↗</span>
            <span class="paper-meta">The European Physical Journal D · 79, 11 · 2025</span>
          </a>
          <a href="/research/" class="more">Full research page →</a>
        </div>
      </div>
    </Section>

    <Section label="Services" top={72} bottom={24} gap={28}>
      <Eyebrow>03 / HOW I CAN HELP</Eyebrow>
      <div class="cards">
        {services.ai.map((s) => <ServiceCard service={s} compact />)}
      </div>
    </Section>

    <ContactCTA
      top={80}
      heading="Shipping an AI feature that needs to survive real traffic?"
      lead="Freelance projects, long-term contracts, or full-time remote AI infrastructure and MLOps roles."
      headingMax={720}
      links={[
        { label: 'LinkedIn ↗', href: site.linkedin, track: 'linkedin' },
        { label: 'GitHub ↗', href: site.github, track: 'github' },
        { label: 'All work →', href: '/' },
      ]}
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  h2 {
    font-size: 40px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .research {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: var(--r-feature);
    padding: clamp(24px, 4vw, 48px);
  }
  .research-head {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .research-head h2 {
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: 0;
  }
  .research-body {
    flex: 999 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .research-body p {
    color: var(--text-muted);
  }
  .paper {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    border-top: 1px solid var(--border);
  }
  .paper-title {
    font-weight: 600;
  }
  .paper-meta {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-subtle);
  }
  .more {
    font-size: 15px;
  }
</style>
