---
import type { FeaturedProject } from '../data/projects';

interface Props {
  project: FeaturedProject;
}
const { project } = Astro.props;
---

<article class="card">
  <div class="content">
    <div class="meta">{project.meta}</div>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <ul>
      {project.bullets.map((b) => <li>{b}</li>)}
    </ul>
  </div>
  <div class="stack">
    <span class="label">STACK</span>
    {project.stack.map((s) => <span>{s}</span>)}
  </div>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-feature);
    padding: clamp(24px, 4vw, 40px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }
  .content {
    flex: 999 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-subtle);
  }
  h3 {
    font-size: 26px;
    line-height: 1.25;
    font-weight: 600;
  }
  p {
    color: var(--text-muted);
    font-size: 16px;
  }
  ul {
    margin: 0;
    padding-left: 20px;
    color: var(--text-body);
    font-size: 15px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stack {
    flex: 1 1 240px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }
  .label {
    color: var(--text-subtle);
    letter-spacing: 0.08em;
  }
</style>
