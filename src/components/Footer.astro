---
import { site } from '../data/site';
---

<footer>
  <div class="inner">
    <span>© 2026 Pratishtha Abrol{site.stats.endpoint && <> · <a href="/privacy/">Privacy</a></>}</span>
    <span>cozy corners, hot tea, cold servers</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
  }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 28px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-subtle);
  }
  a {
    color: inherit;
  }
</style>
