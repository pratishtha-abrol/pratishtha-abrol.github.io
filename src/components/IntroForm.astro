---
// Optional "introduce yourself" form inside the contact panel. Collapsed by
// default and never blocks anything. Posts to the stats Worker, which emails
// the owner. Rendered only when site.stats.endpoint is set.
import { site } from '../data/site';

const endpoint = site.stats.endpoint;
const reply = site.responseTime ? ` I usually reply within ${site.responseTime}.` : '';
---

{endpoint && (
  <details class="intro" open>
    <summary>Hiring or have a project? Introduce yourself</summary>
    <form data-endpoint={endpoint} data-email={site.email}>
      <p class="hint">Tell me who you are and what you need.{reply}</p>
      <div class="grid">
        <label><span class="lbl">Your name</span><input name="name" required maxlength="100" autocomplete="name" /></label>
        <label><span class="lbl">Email</span><input type="email" name="email" required maxlength="200" autocomplete="email" /></label>
        <label><span class="lbl">Company <em>(optional)</em></span><input name="company" maxlength="120" autocomplete="organization" /></label>
        <label>
          <span class="lbl">This is about</span>
          <select name="intent" required>
            <option value="hiring">I'm hiring</option>
            <option value="project">I have a project</option>
            <option value="hello">Just saying hi</option>
          </select>
        </label>
        <label class="wide"><span class="lbl">Message <em>(optional)</em></span><textarea name="message" rows="4" maxlength="2000"></textarea></label>
        <input class="hp" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      </div>
      <div class="actions">
        <button type="submit" class="submit">Send</button>
        <span class="status" role="status" aria-live="polite"></span>
      </div>
      <p class="fine">Sent only to me. See the <a href="/privacy/">privacy note</a>.</p>
    </form>
  </details>
)}

<style>
  .intro {
    border-top: 1px solid var(--border);
    padding-top: 8px;
    margin-top: 4px;
  }
  summary {
    cursor: pointer;
    list-style: none;
    padding: 10px 0;
    color: var(--accent);
    font-size: 20px;
    font-weight: 700;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: ' ↓';
  }
  details[open] summary::after {
    content: ' ↑';
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 8px 0 4px;
    max-width: 720px;
  }
  .hint {
    color: var(--text-muted);
    font-size: 15px;
  }
  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  label {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .lbl em {
    font-style: normal;
    color: var(--text-subtle);
  }
  .wide {
    flex-basis: 100%;
  }
  input,
  select,
  textarea {
    font: inherit;
    font-size: 16px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-button);
    padding: 12px 14px;
    width: 100%;
    box-sizing: border-box;
  }
  textarea {
    resize: vertical;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .submit {
    font: inherit;
    cursor: pointer;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    border: 0;
    border-radius: var(--r-button);
    padding: 14px 22px;
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .status {
    font-size: 15px;
    color: var(--text-muted);
  }
  .fine {
    font-size: 13px;
    color: var(--text-subtle);
  }
  .fine a {
    color: var(--text-muted);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('details.intro form');
  if (form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const submit = form.querySelector<HTMLButtonElement>('.submit')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      let ref: string | null = null;
      try {
        ref = sessionStorage.getItem('ref');
      } catch {}
      submit.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.dataset.endpoint!.replace(/\/$/, '') + '/i', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            email: data.get('email'),
            company: data.get('company'),
            intent: data.get('intent'),
            message: data.get('message'),
            hp: data.get('hp'),
            t: Math.round(performance.now()), // time on page: bots submit instantly
            r: ref,
            p: location.pathname,
          }),
        });
        if (res.ok) {
          status.textContent = `Thank you! I'll reply to ${data.get('email')} soon.`;
          form.reset();
          return; // button stays disabled: one send per page load
        }
        const body = (await res.json().catch(() => null)) as { error?: string } | null;
        status.textContent = body?.error ?? 'Something went wrong.';
      } catch {
        status.innerHTML = '';
        const a = document.createElement('a');
        a.href = `mailto:${form.dataset.email}`;
        a.textContent = form.dataset.email ?? '';
        status.append('Could not send. Please email ', a, ' instead.');
      }
      submit.disabled = false;
    });
  }
</script>
